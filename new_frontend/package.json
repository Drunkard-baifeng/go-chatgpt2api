  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons:generate": "node scripts/generate-local-icons.mjs",
