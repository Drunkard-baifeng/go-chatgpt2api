    "@types/markdown-it": "^14.1.2",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "axios": "^1.21.1",
    "highlight.js": "^11.11.1",
    "js-beautify": "^2.0.3",
    "markdown-it": "^14.3.3",
    "nanocat-ui": "0.1.10",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
